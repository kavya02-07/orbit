# ── Orbit Backend Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in real values. 

# Google Gemini API key (required for AI question-answering)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_jwt_secret_key_here

# JWT algorithm and token lifetime
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQLite database path (relative to backend/)
DATABASE_URL=sqlite+aiosqlite:///./orbit.db

# FAISS index storage directory (relative to backend/)
FAISS_INDEX_PATH=./data/faiss_index

# Uploaded documents storage directory (relative to backend/)
UPLOAD_DIR=./data/uploads

# Embedding model (must match all-MiniLM-L6-v2)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Gemini model name
GEMINI_MODEL=gemini-1.5-flash

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173
